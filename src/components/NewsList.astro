---
import { fmt, slugOf, type Lang } from '../lib/news';
import type { CollectionEntry } from 'astro:content';
interface Props { items: CollectionEntry<'news'>[]; lang: Lang }
const { items, lang } = Astro.props;
const base = lang === 'ja' ? '/news/' : '/en/news/';
const empty = lang === 'ja' ? 'お知らせはまだありません' : 'No news yet';
---
<ul class="news">
  {items.length === 0 && <li class="empty">{empty}</li>}
  {items.map((e) => (
    <li>
      <a href={`${base}${slugOf(e)}/`}>
        {e.data.image ? <img src={e.data.image} alt="" loading="lazy" /> : <span class="noimg"></span>}
        <span class="meta"><time>{fmt(e.data.publishDate, lang)}</time>{e.data.category && <span class="cat">{e.data.category}</span>}</span>
        <span class="t">{e.data.title}</span>
      </a>
    </li>
  ))}
</ul>
<style>
  .news { list-style:none; padding:0; margin:0; display:grid; gap:16px; }
  .news a { display:grid; grid-template-columns: 120px 1fr; grid-template-rows:auto 1fr; gap:4px 16px; text-decoration:none; padding:12px; border:1px solid var(--line); border-radius:10px; }
  .news a:hover { background: var(--soft); }
  .news img, .noimg { grid-row: 1 / 3; width:120px; height:80px; object-fit:cover; border-radius:6px; background: var(--soft); display:block; }
  .meta { font-size:13px; color:var(--muted); display:flex; gap:10px; align-items:center; }
  .cat { border:1px solid var(--line); border-radius:999px; padding:0 10px; }
  .t { font-weight:700; }
  .empty { color: var(--muted); }
  @media (max-width: 560px) { .news a { grid-template-columns: 88px 1fr; } .news img, .noimg { width:88px; height:64px; } }
</style>
