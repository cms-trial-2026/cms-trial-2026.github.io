---
interface Props { title: string; lang: 'ja' | 'en'; alt: string }
const { title, lang, alt } = Astro.props;
const t = lang === 'ja'
  ? { site: 'サンプル展示会 2027', news: 'お知らせ', top: 'トップ', other: 'English', note: 'これは CMS の動作確認用のサンプルサイトです' }
  : { site: 'Sample Exhibition 2027', news: 'News', top: 'Home', other: '日本語', note: 'This is a sample site for testing the CMS' };
const base = lang === 'ja' ? '/' : '/en/';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{title} | {t.site}</title>
  <style>
    :root { --ink:#1b1b1f; --muted:#6b6b76; --line:#e3e3e8; --accent:#2b59c3; --bg:#ffffff; --soft:#f5f6f8; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: "Hiragino Sans","Noto Sans JP",system-ui,sans-serif; color:var(--ink); background:var(--bg); line-height:1.75; }
    a { color: inherit; }
    .bar { background: var(--ink); color:#fff; font-size:13px; text-align:center; padding:6px 16px; }
    header { border-bottom:1px solid var(--line); }
    .wrap { max-width: 920px; margin: 0 auto; padding: 0 20px; }
    .nav { display:flex; align-items:center; justify-content:space-between; height:64px; }
    .logo { font-weight:700; text-decoration:none; font-size:18px; }
    .nav nav { display:flex; gap:18px; font-size:15px; }
    .nav nav a { text-decoration:none; }
    main { padding: 32px 0 64px; }
    footer { border-top:1px solid var(--line); color:var(--muted); font-size:13px; padding:24px 0; }
  </style>
</head>
<body>
  <div class="bar">{t.note}</div>
  <header><div class="wrap nav">
    <a class="logo" href={base}>{t.site}</a>
    <nav><a href={base}>{t.top}</a><a href={`${base}news/`}>{t.news}</a><a href={alt} lang={lang === 'ja' ? 'en' : 'ja'}>{t.other}</a></nav>
  </div></header>
  <main class="wrap"><slot /></main>
  <footer><div class="wrap">© Sample Exhibition 2027</div></footer>
</body>
</html>
